# Copy to ".env" (repo root) and fill in what you use. Every value here
# is optional — with none of them set, the blueprint runs fully offline:
# the deterministic rules backend, in-memory test doubles, samples.
# Real environment variables always override this file.

# --- Decision backend (the System One port) ---------------------------
# offline (default) | jev | llm | openai | anthropic | ollama
# Start with a real provider: DECISION_BACKEND=jev with a TypeSafe key,
# or DECISION_BACKEND=llm with one of the provider keys below.
DECISION_BACKEND=offline

# TypeSafe AI (Jev) — early access. The adapter calls the documented
# primitives endpoint; a missing/invalid key fails loudly, never silently.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev
# DECISION_TIMEOUT_SECONDS=30

# LLM adapter — structured output over the standard provider seam.
# DECISION_BACKEND=llm picks: ANTHROPIC_API_KEY first, else OPENAI_API_KEY,
# else Ollama. Or select a provider directly: DECISION_BACKEND=anthropic etc.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Any OpenAI-compatible endpoint works via OPENAI_BASE_URL — hosted
# gateways, Azure, LiteLLM, and NVIDIA NIM:
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1   (with an nvapi- key)
# OPENAI_BASE_URL=http://localhost:8000/v1              (self-hosted NIM)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# LLM_TIMEOUT_SECONDS=60

# --- Embeddings (duplicate detection) ---------------------------------
# Default: deterministic hashing embedder (offline stand-in). Set
# EMBEDDER=provider to use OPENAI_API_KEY's /embeddings endpoint instead.
# EMBEDDER=provider
# EMBEDDING_MODEL=text-embedding-3-small
# DUPLICATE_SIMILARITY_THRESHOLD=0.85
# SIMILARITY_FLOOR=0.30   (for "similar past tickets"; below the duplicate threshold)

# --- Reopens ------------------------------------------------------------
# A reopen chain that reaches this many reopens is forced to human
# review instead of being composed again (default 2).
# REOPEN_LIMIT=2

# --- Calibration drift watch -------------------------------------------
# The recent live window is compared to the eval baseline per question;
# a question flags only past the sample floor, degraded by the threshold.
# DRIFT_WINDOW=50
# DRIFT_MIN_SAMPLES=20
# DRIFT_BRIER_THRESHOLD=0.05

# --- Gate webhooks (optional) ------------------------------------------
# POST a compact JSON event when a run reaches the agent gate (and
# when its guardrails block). Fire-and-forget: failures are logged,
# never fatal. The secret, when set, rides as a header the receiver
# can verify.
# TRIAGE_WEBHOOK_URL=https://example.com/triage-hook
# TRIAGE_WEBHOOK_SECRET=<redacted>

# --- Production persistence (docker compose sets these) ---------------
# PostgreSQL: triage records + LangGraph checkpoints + pgvector index.
# DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
# CHECKPOINTS=off
# S3-compatible bucket for raw ticket payloads:
# S3_BUCKET=ticket-payloads
# S3_ENDPOINT_URL=http://localhost:8333
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- API ----------------------------------------------------------------
# Optional shared key: when set, routes require the X-API-Key header.
# API_KEY=
